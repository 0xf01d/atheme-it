#: modules/chanserv/xop.c:298
#, c-format
msgid "\002%s\002 %s template has founder flag, not allowing XOP command."
msgstr "Il template %s di \002%s\002 ha il flag founder; comando XOP non consentito."

#: modules/chanserv/moderate.c:327
#, c-format
msgid "\002%s\002 (\002%s\002) [%s (%s ago)]"
msgstr "\002%s\002 (\002%s\002) [%s (%s fa)]"

#: modules/chanfix/fix.c:809
#, c-format
msgid "\002%s\002 allows for simple channel operator management."
msgstr "\002%s\002 consente una gestione semplice degli operatori di canale."

#: modules/alis/main.c:427
#, c-format
msgid ""
"\002%s\002 allows searching for channels with more\n"
"flexibility than the \002/LIST\002 command."
msgstr ""
"\002%s\002 permette di cercare i canali con più\n"
"flessibilità rispetto al comando \002/LIST\002."

#: modules/nickserv/help.c:56
#, c-format
msgid ""
"\002%s\002 allows users to \002'register'\002 a nickname, and stop\n"
"others from using that nick. \002%s\002 allows the owner of a\n"
"nickname to disconnect a user from the network that is using\n"
"their nickname."
msgstr ""
"\002%s\002 permette agli utenti di \002'registrare'\002 un nickname e di\n"
"impedire ad altri di usare quel nick. \002%s\002 consente al proprietario\n"
"di un nickname di disconnettere dalla rete un utente che sta usando\n"
"il proprio nickname."

#: modules/nickserv/help.c:41
#, c-format
msgid ""
"\002%s\002 allows users to \002'register'\002 an account for use with "
"\002%s\002."
msgstr ""
"\002%s\002 permette agli utenti di \002'registrare'\002 un account per l'uso "
"con \002%s\002."

#: modules/botserv/help.c:24
#, c-format
msgid "\002%s\002 allows users to request a custom bot for their channel."
msgstr "\002%s\002 permette agli utenti di richiedere un bot personalizzato per il proprio canale."

#: modules/hostserv/help.c:23
#, c-format
msgid "\002%s\002 allows users to request a virtual hostname."
msgstr "\002%s\002 permette agli utenti di richiedere un hostname virtuale."

#: modules/helpserv/main.c:26
#, c-format
msgid "\002%s\002 allows users to request help from network staff."
msgstr "\002%s\002 permette agli utenti di richiedere aiuto allo staff della rete."

#: modules/rpgserv/help.c:24
#, c-format
msgid ""
"\002%s\002 allows users to search for game channels by matching\n"
"channels against certain criteria."
msgstr ""
"\002%s\002 permette agli utenti di cercare canali di gioco confrontando\n"
"i canali con determinati criteri."

#: modules/memoserv/help.c:24
#, c-format
msgid "\002%s\002 allows users to send memos to registered users."
msgstr "\002%s\002 permette agli utenti di inviare memo agli utenti registrati."

#: modules/infoserv/main.c:58
#, c-format
msgid "\002%s\002 allows users to view informational messages."
