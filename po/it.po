#: src/ecdh-x25519-tool/main.c:264
msgid ""
"\n"
"Usage: ecdh-x25519-tool [-h | -v | -T]\n"
"       ecdh-x25519-tool [-f <path>] [-c | -p | -q | -r <msg> | -s]\n"
"\n"
"  -h / --help               Print this message\n"
"  -v / --version            Print version information\n"
"  -T / --selftest-only      Exit after running X25519 ECDH self-test\n"
"  -f / --key-file <path>    Path to key file for reading or writing\n"
"  -c / --create-keypair     Write new key pair to file, print public key\n"
"  -p / --print-pubkey       Read existing key file, print public key\n"
"  -q / --print-qrcode       Print PRIVATE AND PUBLIC KEY as a QR-Code\n"
"  -r / --respond <msg>      Generate response to a server message\n"
"  -s / --server             Generate a server message (for testing)\n"
"\n"
"If \"-f\" is not given, \"-f -\" is assumed. This means use stdin/stdout.\n"
"\n"
"If \"-c -f -\" is given, the entire RAW key pair will be written to stdout.\n"
"     Please ensure that stdout is NOT a terminal if this is the case!\n"
msgstr "\nUso: ecdh-x25519-tool [-h | -v | -T]\n       ecdh-x25519-tool [-f <percorso>] [-c | -p | -q | -r <msg> | -s]\n\n  -h / --help               Stampa questo messaggio\n  -v / --version            Stampa le informazioni sulla versione\n  -T / --selftest-only      Esce dopo aver eseguito l'autotest ECDH X25519\n  -f / --key-file <percorso> Percorso del file di chiavi da leggere o scrivere\n  -c / --create-keypair     Scrive una nuova coppia di chiavi su file e stampa la chiave pubblica\n  -p / --print-pubkey       Legge il file di chiavi esistente e stampa la chiave pubblica\n  -q / --print-qrcode       Stampa CHIAVE PRIVATA E PUBBLICA come QR-Code\n  -r / --respond <msg>      Genera una risposta a un messaggio del server\n  -s / --server             Genera un messaggio del server (per test)\n\nSe \"-f\" non viene fornito, si assume \"-f -\", cioè usare stdin/stdout.\n\nCon \"-c -f -\" l'intera coppia di chiavi GREZZA viene scritta su stdout.\n     In questo caso assicurarsi che stdout NON sia un terminale!\n"

