#: src/crypto-benchmark/main.c:135
msgid ""
"\n"
"  -h/--help                    Display this help information and exit\n"
"  -v/--version                 Display program version and exit\n"
"  -T/--run-selftests-only      Exit after testing all supported algorithms\n"
"\n"
"  -o/--run-optimal-benchmarks  Perform an automatic parameter tuning "
"benchmark:\n"
"  -g/--optimal-clock-limit       Wall clock time limit for optimal "
"benchmarks\n"
"                                   (in seconds, fractional values accepted)\n"
"  -l/--optimal-memory-limit      Memory limit for optimal benchmarking\n"
"                                   (as a power of 2, in KiB)\n"
"                                   For example, '-l 16' means 2^16 KiB; 64 "
"MiB\n"
"  -i/--with-sasl-scram           Indicate that you wish to deploy SASL "
"SCRAM\n"
"                                   This changes the PBKDF2 configuration "
"advice\n"
"\n"
"  -a/--run-argon2-benchmarks   Benchmark the Argon2 code with "
"configurations:\n"
"  -n/--argon2-types              Comma-separated types\n"
"  -m/--argon2-memory-costs       Comma-separated memory costs\n"
"  -t/--argon2-time-costs         Comma-separated time costs\n"
"  -p/--argon2-threads            Comma-separated thread counts\n"
"\n"
"  -s/--run-scrypt-benchmarks   Benchmark the scrypt code with "
"configurations:\n"
"  -e/--scrypt-memlimits          Comma-separated memlimits\n"
"  -f/--scrypt-opslimits          Comma-separated opslimits\n"
"\n"
"  -b/--run-bcrypt-benchmarks   Benchmark the bcrypt code with "
"configurations:\n"
"  -r/--bcrypt-costs              Comma-separated bcrypt costs\n"
"\n"
"  -k/--run-pbkdf2-benchmarks   Benchmark the PBKDF2 code with "
"configurations:\n"
"  -c/--pbkdf2-iterations         Comma-separated iteration counts\n"
"  -d/--pbkdf2-digests            Comma-separated digest algorithms\n"
"\n"
"  Valid Argon2 types are: Argon2d, Argon2i, Argon2id (case-insensitive)\n"
"  Valid PBKDF2 digests are: MD5, SHA1, SHA2-256, SHA2-512 (case-"
"insensitive)\n"
"\n"
"  If one of the above customisable options are not given, defaults are "
"used.\n"
"  One of -h/-v/-o/-a/-s/-k MUST be given. They are all mutually-exclusive.\n"
msgstr ""
"\n"
"  -h/--help                    Mostra queste informazioni di aiuto ed esce\n"
"  -v/--version                 Mostra la versione del programma ed esce\n"
"  -T/--run-selftests-only      Esce dopo aver testato tutti gli algoritmi "
"supportati\n"
"\n"
"  -o/--run-optimal-benchmarks  Esegue un benchmark di taratura automatica "
"dei parametri:\n"
"  -g/--optimal-clock-limit       Limite di tempo reale per i benchmark "
"optimal\n"
"                                   (in secondi, valori frazionari accettati)\n"
"  -l/--optimal-memory-limit      Limite di memoria per il benchmark optimal\n"
"                                   (come potenza di 2, in KiB)\n"
"                                   Ad esempio, '-l 16' significa 2^16 KiB; 64 "
"MiB\n"
"  -i/--with-sasl-scram           Indica che intendi deployare SASL "
"SCRAM\n"
"                                   Ciò modifica i consigli di "
"configurazione PBKDF2\n"
"\n"
"  -a/--run-argon2-benchmarks   Esegue il benchmark del codice Argon2 con le "
"configurazioni:\n"
"  -n/--argon2-types              Tipi separati da virgole\n"
"  -m/--argon2-memory-costs       Costi di memoria separati da virgole\n"
"  -t/--argon2-time-costs         Costi di tempo separati da virgole\n"
"  -p/--argon2-threads            Numeri di thread separati da virgole\n"
"\n"
"  -s/--run-scrypt-benchmarks   Esegue il benchmark del codice scrypt con le "
"configurazioni:\n"
"  -e/--scrypt-memlimits          Memlimit separati da virgole\n"
"  -f/--scrypt-opslimits          Opslimit separati da virgole\n"
"\n"
"  -b/--run-bcrypt-benchmarks   Esegue il benchmark del codice bcrypt con le "
"configurazioni:\n"
"  -r/--bcrypt-costs              Costi bcrypt separati da virgole\n"
"\n"
"  -k/--run-pbkdf2-benchmarks   Esegue il benchmark del codice PBKDF2 con le "
"configurazioni:\n"
"  -c/--pbkdf2-iterations         Numeri di iterazioni separati da virgole\n"
"  -d/--pbkdf2-digests            Algoritmi di digest separati da virgole\n"
"\n"
"  I tipi Argon2 validi sono: Argon2d, Argon2i, Argon2id (maiuscole/minuscole "
"irrilevanti)\n"
"  I digest PBKDF2 validi sono: MD5, SHA1, SHA2-256, SHA2-512 "
"(maiuscole/minuscole irrilevanti)\n"
"\n"
"  Se una delle opzioni personalizzabili sopra non viene fornita, vengono "
"usati i valori predefiniti.\n"
"  Una tra -h/-v/-o/-a/-s/-k DEVE essere fornita. Sono tutte mutuamente "
"esclusive.\n"

